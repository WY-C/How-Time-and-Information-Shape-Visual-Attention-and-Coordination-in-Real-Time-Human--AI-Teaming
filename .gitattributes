# Public research data. Git LFS keeps the repository history usable while the
# files remain available to a normal `git lfs pull` clone.
data/**/*.csv filter=lfs diff=lfs merge=lfs -text
data/**/*.tsv filter=lfs diff=lfs merge=lfs -text
data/**/*.json filter=lfs diff=lfs merge=lfs -text
data/**/*.xlsx filter=lfs diff=lfs merge=lfs -text
data/**/*.npz filter=lfs diff=lfs merge=lfs -text
data/**/*.joblib filter=lfs diff=lfs merge=lfs -text
data/**/*.pt filter=lfs diff=lfs merge=lfs -text
data/**/*.png filter=lfs diff=lfs merge=lfs -text

# Model assets and large planner fixtures.
final_model/checkpoint/**/*.pt filter=lfs diff=lfs merge=lfs -text
predict_path/output/**/*.pt filter=lfs diff=lfs merge=lfs -text
model/**/*.pt filter=lfs diff=lfs merge=lfs -text
lib/overcooked_ai/**/*.pkl filter=lfs diff=lfs merge=lfs -text
lib/overcooked_ai/**/*.pickle filter=lfs diff=lfs merge=lfs -text
